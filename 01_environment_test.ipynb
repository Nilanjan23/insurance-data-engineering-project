   "source": [
    "import os\n",
    "\n",
    "os.environ[\"SPARK_LOCAL_HOSTNAME\"] = \"localhost\"\n",
    "\n",
    "from pyspark.sql import SparkSession\n",
    "\n",
    "spark = SparkSession.builder \\\n",
    "    .master(\"local[*]\") \\\n",
    "    .appName(\"InsuranceProject\") \\\n",
    "    .getOrCreate()\n",
    "\n",
    "print(\"Spark Installed Successfully\")"
   ]
